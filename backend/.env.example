# Railway sets PORT automatically; 5000 is only the local default.
PORT=5000
NODE_ENV=development

# Local: mongodb://127.0.0.1:27017/worktrack
# Railway: use the MongoDB plugin's MONGO_URL or a MongoDB Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/worktrack

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated. Wildcards allowed, e.g. https://*.vercel.app for preview deploys.
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001

# Demo data (demo users, password Worktrack@123). Defaults to true locally, false when NODE_ENV=production.
# SEED_DEMO_DATA=false

# Used only when demo data is off and no super admin exists yet (first production boot).
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Super Admin
COMPANY_NAME=WorkTrack

# Required in production: Railway's disk is wiped on every deploy, so files must go to Cloudinary.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
